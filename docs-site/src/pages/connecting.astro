---
import DocsLayout from '../components/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Note from '../components/Note.astro';

const redisCode = `[[<span class="c-yellow">connection</span>]]
<span class="c-green">type</span> = <span class="c-lime">"redis"</span>
<span class="c-green">name</span> = <span class="c-lime">"local"</span>
<span class="c-green">host</span> = <span class="c-lime">"127.0.0.1"</span>
<span class="c-green">port</span> = <span class="c-purple">6379</span>
<span class="c-green">db</span>   = <span class="c-purple">0</span>`;
const redisPlain = `[[connection]]
type = "redis"
name = "local"
host = "127.0.0.1"
port = 6379
db   = 0`;

const amqpCode = `[[<span class="c-yellow">connection</span>]]
<span class="c-green">type</span> = <span class="c-lime">"amqp"</span>
<span class="c-green">name</span> = <span class="c-lime">"activemq"</span>
<span class="c-green">host</span> = <span class="c-lime">"127.0.0.1"</span>
<span class="c-green">port</span> = <span class="c-purple">5672</span>
<span class="c-muted"># AMQP 1.0 can't list destinations — curate them:</span>
<span class="c-green">destinations</span> = [<span class="c-lime">"topic:events"</span>, <span class="c-lime">"queue:orders"</span>]`;
const amqpPlain = `[[connection]]
type = "amqp"
name = "activemq"
host = "127.0.0.1"
port = 5672
destinations = ["topic:events", "queue:orders"]`;

const rabbitCode = `[[<span class="c-yellow">connection</span>]]
<span class="c-green">type</span>     = <span class="c-lime">"rabbitmq"</span>
<span class="c-green">name</span>     = <span class="c-lime">"rabbit"</span>
<span class="c-green">host</span>     = <span class="c-lime">"127.0.0.1"</span>
<span class="c-green">port</span>     = <span class="c-purple">5672</span>
<span class="c-green">vhost</span>    = <span class="c-lime">"/"</span>
<span class="c-green">username</span> = <span class="c-lime">"guest"</span>
<span class="c-green">password</span> = <span class="c-lime">"env:RABBIT_PW"</span>`;
const rabbitPlain = `[[connection]]
type     = "rabbitmq"
name     = "rabbit"
host     = "127.0.0.1"
port     = 5672
vhost    = "/"
username = "guest"
password = "env:RABBIT_PW"`;

const tlsCode = `[[<span class="c-yellow">connection</span>]]
<span class="c-green">type</span>     = <span class="c-lime">"rabbitmq"</span>
<span class="c-green">name</span>     = <span class="c-lime">"prod"</span>
<span class="c-green">host</span>     = <span class="c-lime">"rabbit.internal"</span>
<span class="c-green">port</span>     = <span class="c-purple">5671</span>
<span class="c-green">tls</span>      = <span class="c-purple">true</span>
<span class="c-green">username</span> = <span class="c-lime">"app"</span>
<span class="c-green">password</span> = <span class="c-lime">"env:RABBIT_PW"</span>   <span class="c-muted"># or keyring[:account] / prompt</span>`;
const tlsPlain = `[[connection]]
type     = "rabbitmq"
name     = "prod"
host     = "rabbit.internal"
port     = 5671
tls      = true
username = "app"
password = "env:RABBIT_PW"`;

const mgmtCode = `[[<span class="c-yellow">connection</span>]]
<span class="c-green">type</span>     = <span class="c-lime">"rabbitmq"</span>
<span class="c-green">name</span>     = <span class="c-lime">"amazon-mq"</span>
<span class="c-green">host</span>     = <span class="c-lime">"b-1234abcd.mq.eu-west-1.amazonaws.com"</span>
<span class="c-green">port</span>     = <span class="c-purple">5671</span>
<span class="c-green">tls</span>      = <span class="c-purple">true</span>
<span class="c-green">username</span> = <span class="c-lime">"app"</span>
<span class="c-green">password</span> = <span class="c-lime">"env:RABBIT_PW"</span>
<span class="c-muted"># Amazon MQ and CloudAMQP serve the API on https://&lt;host&gt; (port 443):</span>
<span class="c-green">management_url</span> = <span class="c-lime">"https://b-1234abcd.mq.eu-west-1.amazonaws.com"</span>
<span class="c-muted"># Optional: another user for the API (default: username / password)</span>
<span class="c-green">management_username</span> = <span class="c-lime">"monitor"</span>
<span class="c-green">management_password</span> = <span class="c-lime">"env:RABBIT_MGMT_PW"</span>`;
const mgmtPlain = `[[connection]]
type     = "rabbitmq"
name     = "amazon-mq"
host     = "b-1234abcd.mq.eu-west-1.amazonaws.com"
port     = 5671
tls      = true
username = "app"
password = "env:RABBIT_PW"
management_url = "https://b-1234abcd.mq.eu-west-1.amazonaws.com"
management_username = "monitor"
management_password = "env:RABBIT_MGMT_PW"`;

const tabs = [
  { id: 'redis', label: 'Redis', dot: '#fb4934' },
  { id: 'amqp', label: 'AMQP 1.0', dot: '#83a598' },
  { id: 'rabbit', label: 'RabbitMQ', dot: '#fe8019' },
];
---

<DocsLayout pageId="connecting">
  <p>
    Keyhole connects to brokers you describe in your config file — one <code>[[connection]]</code>
    table each, tagged by <code>type</code>. Pick one from the list on launch, or jump to it with
    <code>--connect &lt;name&gt;</code>. Keyhole writes to a broker only when you publish a message
    or peek a queue (a RabbitMQ peek takes messages off and puts them back; see
    <a href="/rabbitmq#modes">Peek modes</a>).
  </p>

  <h3 id="define" data-toc="define">Defining a connection</h3>
  <p>Pick a broker to see its <code>[[connection]]</code> block:</p>

  <div class="broker-tabs" data-broker-tabs>
    {
      tabs.map((t, i) => (
        <button
          class:list={['broker-tab', { active: i === 0 }]}
          type="button"
          data-broker-tab={t.id}
        >
          <span class="bdot" style={`background:${t.dot}`} />
          {t.label}
        </button>
      ))
    }
  </div>

  <div data-broker-panel="redis">
    <CodeBlock cmd={redisPlain} code={redisCode} dense />
  </div>
  <div data-broker-panel="amqp" hidden>
    <CodeBlock cmd={amqpPlain} code={amqpCode} dense />
  </div>
  <div data-broker-panel="rabbit" hidden>
    <CodeBlock cmd={rabbitPlain} code={rabbitCode} dense />
  </div>

  <h3 id="redis" data-toc="redis"><span class="h3-dot" style="background:#fb4934"></span>Redis</h3>
  <p>
    The fullest experience: keyspace browser, value inspector, the read-only console, and every tail
    type (pub/sub, pattern, streams, keyspace events, MONITOR). Choose the database with the
    <code>db</code> field, or switch it live once connected.
  </p>

  <h3 id="amqp" data-toc="amqp"><span class="h3-dot" style="background:#83a598"></span>AMQP 1.0</h3>
  <p>
    Browse and tail topics and queues. AMQP 1.0 can't enumerate destinations, so you list the ones
    you care about in <code>destinations</code> — or point <code>management_url</code> at a Jolokia
    console (e.g. ActiveMQ's) to auto-discover them.
  </p>

  <h3 id="rabbit" data-toc="rabbit">
    <span class="h3-dot" style="background:#fe8019"></span>RabbitMQ
  </h3>
  <p>
    Browse the virtual host's queues and exchanges, peek a queue's messages, tap an exchange to watch
    routed messages flow through, and publish — see the <a href="/rabbitmq">RabbitMQ browser</a>.
    Set the virtual host with <code>vhost</code> (default <code>/</code>); Keyhole shows only that
    one. The list, peeks, stats and the connection and consumer tabs come from RabbitMQ's HTTP
    management API (below). Taps only need AMQP: without the API, type
    <code>exchange:name[/binding_key]</code> at the Tail anchor.
  </p>

  <h3 id="mgmt" data-toc="mgmt">RabbitMQ management API</h3>
  <p>
    AMQP 0.9.1 can't list queues or exchanges or report stats, so Keyhole reads them from the
    <code>rabbitmq_management</code> plugin's HTTP API. By default it looks for it at
    <code>http://&lt;host&gt;:15672</code> (<code>https://&lt;host&gt;:15671</code> with
    <code>tls = true</code>) and logs in with the connection's <code>username</code> and
    <code>password</code>: RabbitMQ has one user database for both. Three optional fields override
    that:
  </p>
  <table>
    <tbody>
      <tr>
        <td class="mono">management_url</td>
        <td>The API's base URL, when it isn't at the default address.</td>
      </tr>
      <tr>
        <td class="mono">management_username</td>
        <td>Another user for the API. Default: <code>username</code>.</td>
      </tr>
      <tr>
        <td class="mono">management_password</td>
        <td>
          That user's password, as a secret spec: <code>env:VAR</code> or
          <code>keyring[:account]</code> (the account defaults to <code>management_username</code>,
          else the connection name). <code>prompt</code> isn't supported here. Default: the AMQP
          <code>password</code>.
        </td>
      </tr>
    </tbody>
  </table>
  <p>
    Managed brokers such as Amazon MQ for RabbitMQ and CloudAMQP serve the API on
    <code>https://&lt;host&gt;</code> (port 443), so set <code>management_url</code> for them:
  </p>
  <CodeBlock cmd={mgmtPlain} code={mgmtCode} dense />
  <p>
    Keyhole checks the API when it connects. If it can't reach it, or the login is refused, the
    connection still opens and taps still work: the destination pane says where it looked and why
    it failed, and <kbd>r</kbd> tries again. The stats band and the Server Details, Connections and
    Consumers tabs are only there when the check at connect succeeded, so reconnect once the API
    answers. A <code>management_password</code> that can't be resolved, such as an unset
    <code>env:</code> variable or a missing keyring entry, does fail the connection.
  </p>
  <p>
    The user needs at least the <code>management</code> tag and the vhost permissions: read
    permission on a queue to peek it. Node health and everyone's connections and consumers need the
    <code>monitoring</code> or <code>administrator</code> tag. A <code>management</code>-only user
    sees only their own connections and consumers, and totals and rates for only their vhosts; the
    tabs say so.
  </p>

  <h3 id="tls" data-toc="tls">TLS &amp; auth</h3>
  <p>
    Set <code>tls = true</code> for a TLS connection (the <code>rediss://</code> / <code>amqps://</code>
    listener on the wire). Authenticate with <code>username</code> and a <code>password</code> spec.
  </p>
  <CodeBlock cmd={tlsPlain} code={tlsCode} dense />
  <Note kind="warning">
    Never put a literal password in the file. <code>password</code> is a spec —
    <code>env:VAR</code>, <code>keyring[:account]</code>, or <code>prompt</code> — resolved at
    connect time.
  </Note>
</DocsLayout>

<style>
  .broker-tabs {
    display: flex;
    gap: 8px;
    margin: 14px 0 4px;
    flex-wrap: wrap;
  }
  .broker-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    border: 1px solid var(--border-strong);
    background: var(--raised);
    color: var(--sec);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 12.5px;
    border-radius: 8px;
    padding: 8px 14px;
  }
  .broker-tab.active {
    background: var(--tab);
    color: var(--bright);
  }
  .bdot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-broker-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-broker-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-broker-panel]'));
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-broker-tab');
        for (const t of tabs) t.classList.toggle('active', t === tab);
        for (const p of panels) p.hidden = p.getAttribute('data-broker-panel') !== id;
      });
    }
  }
</script>
